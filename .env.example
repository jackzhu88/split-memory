# Copy to secrets/.env (preferred) or .env — never commit real values.
# See secrets/README.md

# Walrus Memory (MemWal) — from https://memory.walrus.xyz/dashboard
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
# Optional: agent id shown in dashboard / submission form (not required by SDK create())
MEMWAL_AGENT_ID=

# Tatum — from https://dashboard.tatum.io (free plan). Readonly only.
TATUM_API_KEY=

# Optional Sui address for identity / submission form only (no gas required for readonly path)
# SUI_ADDRESS=

# Optional server bind (local demo defaults: HOST=127.0.0.1 PORT=8787)
# HOST=0.0.0.0
# PORT=8787
